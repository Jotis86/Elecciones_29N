---
import '../styles/global.css';
import { sitio, formatearFecha } from '../lib/datos';

interface Props {
  titulo?: string;
  descripcion?: string;
  noindex?: boolean;
  imagen?: string;
  imagenAlt?: string;
}

const {
  titulo,
  descripcion,
  noindex = false,
  imagen: imagenProp,
  imagenAlt,
} = Astro.props;
const nombreCompleto = titulo ? `${titulo} · Programas 29N` : 'Programas electorales · 29N';
const descripcionFinal =
  descripcion ??
  'Los programas de los partidos que concurren a las elecciones generales del 29 de noviembre de 2026, resumidos por temas y con cada propuesta enlazada a la página exacta del documento oficial.';

const ruta = Astro.url.pathname;
const canonica = new URL(ruta, Astro.site);
const imagen = new URL(imagenProp ?? '/og.png', Astro.site);
const imagenAltFinal =
  imagenAlt ?? '29N · Programas electorales: cada propuesta enlazada a la página exacta del PDF';
const activo = (href: string) =>
  href === '/' ? ruta === '/' : ruta.startsWith(href.split('#')[0]);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Programas electorales 29N',
  url: new URL('/', Astro.site).href,
  inLanguage: 'es',
  description: descripcionFinal,
  publisher: { '@type': 'Person', name: sitio.autor },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${new URL('/buscar/', Astro.site).href}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{nombreCompleto}</title>
    <meta name="description" content={descripcionFinal} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#fcfbf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101114" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonica} />
    <meta property="og:site_name" content="Programas electorales 29N" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={nombreCompleto} />
    <meta property="og:description" content={descripcionFinal} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagenAltFinal} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={nombreCompleto} />
    <meta name="twitter:description" content={descripcionFinal} />
    <meta name="twitter:image" content={imagen} />
    <meta name="twitter:image:alt" content={imagenAltFinal} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <p id="compartir-estado" class="visualmente-oculto" role="status" aria-live="polite"></p>

    <header class="sitio-cabecera">
      <div class="wrap">
        <a class="marca" href="/">
          <strong>29N</strong>
          <span>Programas electorales</span>
        </a>
        <nav class="sitio-nav" aria-label="Principal">
          <a href="/temas" aria-current={activo('/temas') ? 'page' : undefined}>Temas</a>
          <a href="/calculadora" aria-current={activo('/calculadora') ? 'page' : undefined}>Calculadora</a>
          <a href="/buscar" aria-current={activo('/buscar') ? 'page' : undefined}>Buscar</a>
          <a href="/programas" aria-current={activo('/programas') ? 'page' : undefined}>Programas</a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="wrap">
        <p>
          Proyecto personal de <strong>{sitio.autor}</strong>, independiente y sin
          afiliación política. Los resúmenes son una interpretación de los
          programas oficiales: cada cita enlaza a la página exacta del documento.
        </p>
        <p>
          <a href="/sobre">Metodología y aviso legal</a> · <a href="/fuentes">Fuentes y cobertura</a><br />
          Última actualización: {formatearFecha(sitio.actualizado)}
        </p>
      </div>
    </footer>
  </body>
</html>
