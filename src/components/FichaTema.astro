---
import type { BloqueTema, Partido } from '../lib/datos';
import { NOMBRE_IDIOMA, enlacePdf } from '../lib/datos';

interface Props {
  partido: Partido;
  bloque: BloqueTema;
  titulo?: string;
  idioma?: 'es' | 'gl' | 'eu' | 'ca';
  /** Prefijo de las anclas de cada propuesta, para enlazar una cita concreta. */
  ancla?: string;
}

const { partido, bloque, titulo, idioma = 'es', ancla } = Astro.props;
const idiomaNombre = NOMBRE_IDIOMA[idioma] ?? idioma;
const base = new URL(Astro.url.pathname, Astro.site);
---

<article class="ficha" style={`--acento:${partido.color}`}>
  <header class="ficha-cabecera">
    <h2>
      {
        titulo ? (
          titulo
        ) : (
          <a href={`/partido/${partido.slug}`} style="text-decoration:none">
            {partido.siglas}
          </a>
        )
      }
    </h2>
    {!titulo && <span class="programa">{partido.programa}</span>}
    {idioma !== 'es' && (
      <span class="sello-idioma">Traducido del {idiomaNombre}</span>
    )}
  </header>

  <p class="resumen">{bloque.resumen}</p>

  <ol class="propuestas">
    {
      bloque.propuestas.map((propuesta, i) => {
        const enlace = enlacePdf(partido, propuesta.pagina);
        const id = ancla ? `${ancla}-propuesta-${i + 1}` : undefined;
        const urlCita = id ? new URL(`${base.pathname}#${id}`, Astro.site).href : undefined;
        return (
          <li id={id}>
            <h3>{propuesta.titular}</h3>
            <blockquote>{propuesta.texto}</blockquote>
            <p class="cita-pie">
              {enlace ? (
                <a
                  class="cita-pagina"
                  href={enlace}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={`Abrir la página ${propuesta.pagina} del programa original`}
                >
                  pág. {propuesta.pagina} · ver en el PDF ↗
                </a>
              ) : (
                <span class="cita-pagina">pág. {propuesta.pagina}</span>
              )}
              {urlCita && (
                <button
                  class="compartir-cita"
                  type="button"
                  data-nativo
                  data-url={urlCita}
                  data-texto={`${propuesta.titular} · ${partido.siglas}`}
                  title="Compartir esta propuesta"
                  aria-label={`Compartir «${propuesta.titular}»`}
                >
                  Compartir cita
                </button>
              )}
            </p>
            {propuesta.texto_original && (
              <details class="original">
                <summary>Ver cita original en {idiomaNombre}</summary>
                <blockquote lang={idioma}>{propuesta.texto_original}</blockquote>
              </details>
            )}
            {propuesta.nota && <p class="nota">{propuesta.nota}</p>}
          </li>
        );
      })
    }
  </ol>
</article>
