---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" descripcion="La página que buscas no existe en Programas 29N.">
  <section class="seccion">
    <div class="wrap">
      <p class="kicker">Error 404</p>
      <h1>Esta página no existe</h1>
      <p class="prosa">
        Puede que el enlace esté mal escrito o que la página haya cambiado.
        Desde aquí puedes volver a la portada, ver los programas o buscar una
        propuesta concreta.
      </p>
      <p style="display:flex;flex-wrap:wrap;gap:0.8rem 1.8rem;margin-top:1.5rem">
        <a class="enlace-flecha" href="/">Volver a la portada →</a>
        <a class="enlace-flecha" href="/programas">Ver los programas →</a>
        <a class="enlace-flecha" href="/buscar">Buscar una propuesta →</a>
      </p>
    </div>
  </section>
</Base>
