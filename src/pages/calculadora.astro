---
import Base from '../layouts/Base.astro';
import datos from '../../data/escanos.json';

const circunscripciones = [...datos.circunscripciones].sort((a, b) =>
  a.nombre.localeCompare(b.nombre, 'es'),
);
---

<Base
  titulo="Calculadora D'Hondt"
  descripcion="Calcula el reparto de escaños por circunscripción con el método D'Hondt y el umbral del 3%. Escaños del anexo del Real Decreto 806/2026."
>
  <header class="pagina-cabecera">
    <div class="wrap">
      <p class="kicker">Herramienta</p>
      <h1>Calculadora D’Hondt</h1>
      <p class="entradilla">
        Elige una circunscripción, reparte porcentajes entre partidos y mira
        cuántos escaños salen. Los escaños son los del anexo del Real Decreto
        806/2026; las reglas, las de la LOREG.
      </p>
    </div>
  </header>

  <section class="seccion">
    <div class="wrap">
      <div class="calc-grid">
        <div class="calc-panel">
          <div class="calc-prov">
            <label for="provincia">Circunscripción</label>
            <select id="provincia">
              {
                circunscripciones.map((c) => (
                  <option value={c.codigo} selected={c.codigo === '28'}>
                    {c.nombre} ({c.diputados})
                  </option>
                ))
              }
            </select>
            <p class="calc-escanos" id="escanos-prov"></p>
          </div>

          <div id="partidos"></div>

          <div class="calc-acciones">
            <button type="button" id="anadir" class="boton secundario">Añadir partido</button>
            <button type="button" id="reiniciar" class="boton secundario">Reiniciar</button>
          </div>

          <div class="calc-fila calc-fila-blanco">
            <span class="calc-punto calc-punto-blanco" aria-hidden="true"></span>
            <span class="calc-nombre-estatico">Voto en blanco</span>
            <input
              type="range"
              class="calc-rango"
              id="blanco-rango"
              min="0"
              max="100"
              step="0.1"
              value="0"
              aria-label="Porcentaje de voto en blanco"
            />
            <input
              type="number"
              class="calc-numero"
              id="blanco-numero"
              min="0"
              max="100"
              step="0.1"
              inputmode="decimal"
              value="0"
              aria-label="Porcentaje de voto en blanco"
            />
            <span class="calc-pct" aria-hidden="true">%</span>
          </div>

          <p class="calc-resumen" id="resumen" role="status"></p>
        </div>

        <div class="calc-panel calc-resultados">
          <h2>Reparto</h2>
          <div id="resultado" aria-live="polite"></div>

          <details class="calc-detalle">
            <summary>Cocientes que reparten los escaños</summary>
            <div id="cocientes"></div>
          </details>
        </div>
      </div>

      <p class="aviso-legal" style="margin-top:1.8rem">
        Simulación, no predicción. No es una encuesta. Los porcentajes son votos
        válidos de la circunscripción: el voto en blanco cuenta para el umbral del
        3% y no recibe escaños; lo que no asignes se considera «otros partidos».
        Escaños: <a href="https://www.boe.es/buscar/doc.php?id=BOE-A-2026-20742" target="_blank" rel="noopener noreferrer">Real Decreto 806/2026, anexo ↗</a>.
        Reglas: <a href="https://www.boe.es/buscar/act.php?id=BOE-A-1985-11672#acientosesentaytres" target="_blank" rel="noopener noreferrer">LOREG, arts. 162 y 163 ↗</a>.
        Los empates de cociente se resuelven por votos totales y, si persisten,
        por sorteo reproducible: la misma entrada da siempre el mismo resultado.
      </p>
    </div>
  </section>

  <script
    type="application/json"
    id="datos-escanos"
    is:inline
    set:html={JSON.stringify(circunscripciones)}
  ></script>

  <script>
    import { repartir } from '../lib/dhondt.js';

    const PALETA = [
      '#1B4D8F', '#E30613', '#63BE21', '#7A2F8F', '#F2A20C', '#2A9D8F',
      '#C2185B', '#6D4C41', '#00843D', '#5C6BC0', '#B71C1C', '#00695C',
    ];

    const circunscripciones = JSON.parse(
      document.getElementById('datos-escanos').textContent,
    );

    const $ = (id) => document.getElementById(id);
    const contenedor = $('partidos');
    const selectProvincia = $('provincia');
    const resumen = $('resumen');
    const resultado = $('resultado');
    const cocientesDiv = $('cocientes');
    const escanosProv = $('escanos-prov');

    let partidos = ['A', 'B', 'C', 'D', 'E', 'F'].map((letra, i) => ({
      id: `p${i + 1}`,
      nombre: `Partido ${letra}`,
      valor: 0,
      color: PALETA[i % PALETA.length],
    }));
    let blanco = 0;

    const nombreDe = (p, i) => p.nombre.trim() || `Partido ${i + 1}`;

    function nodo(tag, clase, texto) {
      const el = document.createElement(tag);
      if (clase) el.className = clase;
      if (texto !== undefined) el.textContent = texto;
      return el;
    }

    function crearFila(p, indice) {
      const fila = nodo('div', 'calc-fila');

      const punto = nodo('span', 'calc-punto');
      punto.style.background = p.color;
      punto.setAttribute('aria-hidden', 'true');

      const nombre = document.createElement('input');
      nombre.type = 'text';
      nombre.className = 'calc-nombre';
      nombre.value = p.nombre;
      nombre.setAttribute('aria-label', `Nombre del partido ${indice + 1}`);
      nombre.addEventListener('input', () => {
        p.nombre = nombre.value;
        calcular();
      });

      const rango = document.createElement('input');
      rango.type = 'range';
      rango.className = 'calc-rango';
      rango.min = '0';
      rango.max = '100';
      rango.step = '0.1';
      rango.value = String(p.valor);
      rango.setAttribute('aria-label', `Porcentaje de ${nombreDe(p, indice)}`);

      const numero = document.createElement('input');
      numero.type = 'number';
      numero.className = 'calc-numero';
      numero.min = '0';
      numero.max = '100';
      numero.step = '0.1';
      numero.inputMode = 'decimal';
      numero.value = String(p.valor);
      numero.setAttribute('aria-label', `Porcentaje de ${nombreDe(p, indice)}`);

      const aplicar = (valor, origen) => {
        const v = Math.min(100, Math.max(0, Number(valor) || 0));
        p.valor = v;
        if (origen !== rango) rango.value = String(v);
        if (origen !== numero) numero.value = String(v);
        calcular();
      };
      rango.addEventListener('input', () => aplicar(rango.value, rango));
      numero.addEventListener('input', () => aplicar(numero.value, numero));

      const pct = nodo('span', 'calc-pct', '%');
      pct.setAttribute('aria-hidden', 'true');

      fila.append(punto, nombre, rango, numero, pct);
      return fila;
    }

    function pintarPartidos() {
      contenedor.textContent = '';
      partidos.forEach((p, i) => contenedor.append(crearFila(p, i)));
    }

    function sincronizarBlanco() {
      const rango = $('blanco-rango');
      const numero = $('blanco-numero');
      const aplicar = (valor, origen) => {
        const v = Math.min(100, Math.max(0, Number(valor) || 0));
        blanco = v;
        if (origen !== rango) rango.value = String(v);
        if (origen !== numero) numero.value = String(v);
        calcular();
      };
      rango.addEventListener('input', () => aplicar(rango.value, rango));
      numero.addEventListener('input', () => aplicar(numero.value, numero));
    }

    function calcular() {
      const provincia = circunscripciones.find((c) => c.codigo === selectProvincia.value);
      const escanos = provincia.diputados;
      escanosProv.textContent =
        `${escanos} diputado${escanos === 1 ? '' : 's'}` +
        (escanos === 1 ? ' · circunscripción uninominal' : '');

      const votos = {};
      const meta = {};
      for (const [i, p] of partidos.entries()) {
        const peso = Math.round(p.valor * 1000);
        if (peso > 0) {
          votos[p.id] = peso;
          meta[p.id] = { nombre: nombreDe(p, i), color: p.color };
        }
      }

      // Sin votos de partidos no hay nada que repartir: no llamamos al
      // algoritmo para no mostrar un «0% para todos» engañoso.
      if (Object.keys(votos).length === 0) {
        resumen.textContent = 'Introduce porcentajes para ver el reparto.';
        resultado.textContent = '';
        resultado.append(
          nodo(
            'p',
            'calc-vacio',
            'Aún no hay votos que repartir. Mueve los porcentajes de la izquierda.',
          ),
        );
        cocientesDiv.textContent = '';
        return;
      }

      const blancoPeso = Math.round(blanco * 1000);
      const totalPartidos = Object.values(votos).reduce((a, b) => a + b, 0);
      const total = totalPartidos + blancoPeso;
      const otros = Math.max(0, 100000 - total);

      const r = repartir({ votos, escanos, blanco: blancoPeso, otros });

      // Resumen del reparto de porcentajes.
      if (total > 100000) {
        resumen.textContent = `Partidos y blanco suman ${(total / 1000).toFixed(1)}%: se normalizan al 100%.`;
      } else {
        const partes = [`Partidos: ${(totalPartidos / 1000).toFixed(1)}%`];
        if (blancoPeso > 0) partes.push(`blanco: ${(blancoPeso / 1000).toFixed(1)}%`);
        if (otros > 0) partes.push(`otros: ${(otros / 1000).toFixed(1)}%`);
        resumen.textContent = partes.join(' · ');
      }

      pintarResultado(r, votos, meta, escanos);
      pintarCocientes(r, meta);
    }

    function pintarResultado(r, votos, meta, escanos) {
      resultado.textContent = '';

      if (r.aptos.length === 0) {
        resultado.append(
          nodo(
            'p',
            'calc-vacio',
            'Ninguna candidatura alcanza el 3% de los votos válidos: no se asigna ningún escaño.',
          ),
        );
        return;
      }

      const pct = (id) => (votos[id] / r.validos) * 100;
      const conEscano = Object.keys(votos)
        .map((id) => ({ id, escanos: r.asignados[id] ?? 0, pct: pct(id) }))
        .filter((x) => x.escanos > 0)
        .sort((a, b) => b.escanos - a.escanos || b.pct - a.pct);

      const maxEscanos = Math.max(...conEscano.map((x) => x.escanos), 1);

      const cifra = nodo('p', 'calc-total');
      cifra.append(nodo('b', null, String(conEscano.reduce((a, b) => a + b.escanos, 0))));
      cifra.append(document.createTextNode(` de ${escanos} escaños asignados`));
      resultado.append(cifra);

      const barras = nodo('div', 'calc-barras');
      for (const x of conEscano) {
        const fila = nodo('div', 'calc-barra');
        const cabecera = nodo('div', 'calc-barra-cabecera');
        cabecera.append(nodo('span', 'calc-barra-nombre', meta[x.id].nombre));
        cabecera.append(
          nodo(
            'span',
            'calc-barra-datos',
            `${x.escanos} escaño${x.escanos === 1 ? '' : 's'} · ${x.pct.toFixed(1)}%`,
          ),
        );
        const pista = nodo('div', 'calc-barra-pista');
        const relleno = nodo('div', 'calc-barra-relleno');
        relleno.style.width = `${(x.escanos / maxEscanos) * 100}%`;
        relleno.style.background = meta[x.id].color;
        pista.append(relleno);
        fila.append(cabecera, pista);
        barras.append(fila);
      }
      resultado.append(barras);

      const sinEscano = Object.keys(votos)
        .map((id) => ({ id, pct: pct(id) }))
        .filter((x) => (r.asignados[x.id] ?? 0) === 0 && x.pct >= 3)
        .sort((a, b) => b.pct - a.pct);

      if (sinEscano.length) {
        resultado.append(
          nodo(
            'p',
            'calc-nota',
            `Superan el 3% pero no obtienen escaño: ${sinEscano
              .map((x) => `${meta[x.id].nombre} (${x.pct.toFixed(1)}%)`)
              .join(', ')}.`,
          ),
        );
      }

      const excluidos = Object.keys(votos)
        .map((id) => ({ id, pct: pct(id) }))
        .filter((x) => x.pct < 3)
        .sort((a, b) => b.pct - a.pct);

      if (excluidos.length) {
        resultado.append(
          nodo(
            'p',
            'calc-nota',
            `Fuera por el umbral del 3%: ${excluidos
              .map((x) => `${meta[x.id].nombre} (${x.pct.toFixed(1)}%)`)
              .join(', ')}.`,
          ),
        );
      }
    }

    function pintarCocientes(r, meta) {
      cocientesDiv.textContent = '';
      if (!r.ganadores.length) return;

      const tabla = nodo('table', 'calc-tabla');
      const thead = document.createElement('thead');
      const filaCabecera = document.createElement('tr');
      for (const titulo of ['#', 'Partido', 'División', 'Cociente']) {
        filaCabecera.append(nodo('th', null, titulo));
      }
      thead.append(filaCabecera);
      tabla.append(thead);

      const tbody = document.createElement('tbody');
      r.ganadores.forEach((g, i) => {
        const fila = document.createElement('tr');
        fila.append(nodo('td', 'num', String(i + 1)));
        fila.append(nodo('td', null, meta[g.partido].nombre));
        fila.append(nodo('td', 'num', `÷ ${g.divisor}`));
        fila.append(nodo('td', 'num', `${(g.cociente / 1000).toFixed(2)}%`));
        tbody.append(fila);
      });
      tabla.append(tbody);
      cocientesDiv.append(tabla);
    }

    $('anadir').addEventListener('click', () => {
      if (partidos.length >= 12) return;
      const i = partidos.length;
      const letra = String.fromCharCode(65 + (i % 26));
      const p = {
        id: `p${i + 1}`,
        nombre: `Partido ${letra}`,
        valor: 0,
        color: PALETA[i % PALETA.length],
      };
      partidos.push(p);
      contenedor.append(crearFila(p, i));
      calcular();
    });

    $('reiniciar').addEventListener('click', () => {
      partidos = partidos.map((p) => ({ ...p, valor: 0 }));
      blanco = 0;
      $('blanco-rango').value = '0';
      $('blanco-numero').value = '0';
      pintarPartidos();
      calcular();
    });

    selectProvincia.addEventListener('change', calcular);

    pintarPartidos();
    sincronizarBlanco();
    calcular();
  </script>

  <style is:global>
    .calc-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 1.5rem;
      align-items: start;
    }

    @media (max-width: 900px) {
      .calc-grid {
        grid-template-columns: 1fr;
      }
    }

    .calc-panel {
      border: 1px solid var(--linea);
      border-radius: var(--radio);
      padding: clamp(1rem, 2.5vw, 1.4rem);
      background: var(--papel);
    }

    .calc-prov {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem 0.9rem;
      margin-bottom: 1rem;
    }

    .calc-prov label {
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--tenue);
    }

    .calc-prov select {
      font: inherit;
      padding: 0.45rem 0.6rem;
      border: 1px solid var(--linea);
      border-radius: var(--radio);
      background: var(--papel);
      color: var(--tinta);
    }

    .calc-escanos {
      margin: 0;
      font-size: 0.85rem;
      color: var(--tenue);
    }

    .calc-fila {
      display: grid;
      grid-template-areas: 'punto nombre rango numero pct';
      grid-template-columns: 14px minmax(0, 1fr) minmax(4.5rem, 1.1fr) 4.8rem auto;
      gap: 0.5rem;
      align-items: center;
      padding: 0.4rem 0;
      border-bottom: 1px solid color-mix(in srgb, var(--linea) 65%, transparent);
    }

    .calc-fila-blanco {
      border-bottom: 0;
      margin-top: 0.2rem;
      padding-top: 0.7rem;
    }

    .calc-punto {
      grid-area: punto;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
    }

    .calc-punto-blanco {
      border: 1px solid var(--tenue);
      background: transparent;
    }

    .calc-nombre-estatico {
      grid-area: nombre;
      font-size: 0.9rem;
      color: var(--tenue);
    }

    .calc-nombre {
      grid-area: nombre;
      font: inherit;
      font-size: 0.9rem;
      padding: 0.32rem 0.45rem;
      border: 1px solid var(--linea);
      border-radius: var(--radio);
      background: var(--papel);
      color: var(--tinta);
      min-width: 0;
      width: 100%;
    }

    .calc-nombre:hover,
    .calc-nombre:focus {
      border-color: var(--tenue);
      background: var(--papel-2);
    }

    .calc-rango {
      grid-area: rango;
      width: 100%;
      accent-color: var(--tinta);
    }

    .calc-numero {
      grid-area: numero;
      font: inherit;
      font-size: 0.9rem;
      padding: 0.3rem 0.35rem;
      border: 1px solid var(--linea);
      border-radius: var(--radio);
      background: var(--papel);
      color: var(--tinta);
      width: 100%;
      font-variant-numeric: tabular-nums;
      text-align: right;
    }

    .calc-pct {
      grid-area: pct;
      font-size: 0.8rem;
      color: var(--tenue);
    }

    .calc-acciones {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0.9rem 0 1rem;
    }

    .calc-acciones .boton {
      font-size: 0.82rem;
      padding: 0.4rem 0.7rem;
    }

    .calc-resumen {
      margin: 1rem 0 0;
      font-size: 0.82rem;
      color: var(--tenue);
      min-height: 1.2em;
      font-variant-numeric: tabular-nums;
    }

    .calc-total {
      margin: 0 0 1rem;
      font-size: 0.92rem;
      color: var(--tenue);
    }

    .calc-total b {
      font-family: 'Iowan Old Style', Georgia, serif;
      font-size: 1.5rem;
      color: var(--tinta);
      margin-right: 0.15rem;
    }

    .calc-barras {
      display: grid;
      gap: 0.85rem;
    }

    .calc-barra-cabecera {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      font-size: 0.9rem;
      margin-bottom: 0.25rem;
    }

    .calc-barra-nombre {
      font-weight: 600;
    }

    .calc-barra-datos {
      color: var(--tenue);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .calc-barra-pista {
      height: 10px;
      border-radius: 99px;
      background: color-mix(in srgb, var(--linea) 55%, transparent);
      overflow: hidden;
    }

    .calc-barra-relleno {
      height: 100%;
      border-radius: 99px;
      transition: width 0.2s ease;
    }

    .calc-vacio {
      margin: 0;
      padding: 1rem 1.2rem;
      border: 1px dashed var(--linea);
      border-radius: var(--radio);
      color: var(--tenue);
      font-size: 0.92rem;
    }

    .calc-nota {
      margin: 1rem 0 0;
      font-size: 0.82rem;
      color: var(--tenue);
    }

    .calc-detalle {
      margin-top: 1.4rem;
      border-top: 1px solid var(--linea);
      padding-top: 0.9rem;
      font-size: 0.85rem;
    }

    .calc-detalle summary {
      cursor: pointer;
      color: var(--tenue);
    }

    .calc-tabla {
      width: 100%;
      border-collapse: collapse;
      margin-top: 0.8rem;
      font-size: 0.82rem;
    }

    .calc-tabla th,
    .calc-tabla td {
      text-align: left;
      padding: 0.32rem 0.4rem;
      border-bottom: 1px solid color-mix(in srgb, var(--linea) 60%, transparent);
    }

    .calc-tabla th {
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--tenue);
      font-weight: 500;
    }

    .calc-tabla .num {
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    @media (max-width: 640px) {
      .calc-fila {
        grid-template-areas: 'punto nombre numero' 'rango rango rango';
        grid-template-columns: 14px minmax(0, 1fr) 4.8rem;
        row-gap: 0.35rem;
      }
      .calc-pct {
        display: none;
      }
      .calc-rango {
        margin-left: 1.4rem;
        width: auto;
      }
    }
  </style>
</Base>
