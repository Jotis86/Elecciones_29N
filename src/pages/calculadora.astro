---
import Base from '../layouts/Base.astro';
import Compartir from '../components/Compartir.astro';
import datos from '../../data/escanos.json';
import resultados2023 from '../../data/resultados_2023.json';

const circunscripciones = [...datos.circunscripciones].sort((a, b) =>
  a.nombre.localeCompare(b.nombre, 'es'),
);

// Solo lo que necesita la interfaz: votos, blanco y escaños de 2023.
const datos2023 = {
  fuente: 'Ministerio del Interior · Congreso 23J 2023',
  provincias: resultados2023.provincias.map((p) => ({
    codigo: p.cod_ine,
    nombre: p.nombre,
    escanos: p.escanos,
    blanco: p.votos_blanco,
    partidos: p.partidos.map((x) => ({ siglas: x.siglas, votos: x.votos })),
  })),
};
---

<Base
  titulo="Calculadora D'Hondt"
  descripcion="Calcula el reparto de escaños por circunscripción con el método D'Hondt y el umbral del 3%. Escaños del anexo del Real Decreto 806/2026."
>
  <header class="pagina-cabecera">
    <div class="wrap">
      <p class="kicker">Herramienta</p>
      <h1>Calculadora D’Hondt</h1>
      <p class="entradilla">
        Elige una circunscripción, reparte porcentajes entre partidos y mira
        cuántos escaños salen. Los escaños son los del anexo del Real Decreto
        806/2026; el modo 2023 usa los votos y los escaños de entonces. Las
        reglas, las de la LOREG.
      </p>
    </div>
  </header>

  <section class="seccion">
    <div class="wrap">
      <div class="calc-grid">
        <div class="calc-panel">
          <div class="calc-prov">
            <label for="provincia">Circunscripción</label>
            <select id="provincia">
              {
                circunscripciones.map((c) => (
                  <option value={c.codigo} selected={c.codigo === '28'}>
                    {c.nombre}
                  </option>
                ))
              }
            </select>
            <p class="calc-escanos" id="escanos-prov"></p>
            <span class="calc-badge" id="modo-badge" hidden>Modo 2023 · resultado oficial</span>
          </div>

          <p class="calc-disponible" id="disponible"></p>

          <div id="partidos"></div>

          <div class="calc-acciones">
            <button type="button" id="anadir" class="boton secundario">Añadir partido</button>
            <button
              type="button"
              id="reproducir"
              class="boton secundario calc-boton-modo"
              aria-pressed="false"
            >
              Reproducir 2023
            </button>
            <button type="button" id="reiniciar" class="boton secundario">Reiniciar</button>
          </div>

          <div class="calc-fila calc-fila-blanco">
            <span class="calc-punto calc-punto-blanco" aria-hidden="true"></span>
            <span class="calc-nombre-estatico">Voto en blanco</span>
            <input
              type="range"
              class="calc-rango"
              id="blanco-rango"
              min="0"
              max="100"
              step="0.1"
              value="0"
              aria-label="Porcentaje de voto en blanco"
            />
            <input
              type="number"
              class="calc-numero"
              id="blanco-numero"
              min="0"
              max="100"
              step="0.1"
              inputmode="decimal"
              value="0"
              aria-label="Porcentaje de voto en blanco"
            />
            <span class="calc-pct" aria-hidden="true">%</span>
          </div>

          <p class="calc-resumen" id="resumen"></p>
        </div>

        <div class="calc-panel calc-resultados">
          <h2>Reparto</h2>
          <div id="resultado"></div>
          <p class="calc-umbral" id="umbral"></p>

          <details class="calc-detalle">
            <summary>Cocientes que reparten los escaños</summary>
            <div id="cocientes"></div>
          </details>
        </div>
      </div>

      <p class="visualmente-oculto" id="anuncio" aria-live="polite"></p>

      <p class="aviso-legal" style="margin-top:1.8rem">
        Simulación, no predicción. No es una encuesta. Los porcentajes son partes
        de los votos válidos de la circunscripción y no pueden sumar más de 100:
        al mover un campo, el resto se ajusta a lo que queda libre. El voto en
        blanco cuenta para el umbral del 3 % y no recibe escaños; lo que dejes sin
        asignar se considera «otros partidos» y también cuenta para el umbral.
        Escaños: <a href="https://www.boe.es/buscar/doc.php?id=BOE-A-2026-20742" target="_blank" rel="noopener noreferrer">Real Decreto 806/2026, anexo ↗</a>.
        Reglas: <a href="https://www.boe.es/buscar/act.php?id=BOE-A-1985-11672#acientosesentaytres" target="_blank" rel="noopener noreferrer">LOREG, arts. 162 y 163 ↗</a>.
        Los empates de cociente se resuelven por votos totales y, si persisten,
        por un sorteo determinista y reproducible. Es una simplificación del
        criterio de la LOREG, que ordena los empates por sorteo y los siguientes
        de forma alternativa.
        El modo 2023 usa los votos oficiales del 23J y los escaños de entonces;
        al editar cualquier porcentaje, vuelve a los escaños de 2026.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="wrap">
      <Compartir texto="Calculadora de escaños del 29N, con el reparto D'Hondt" />
    </div>
  </section>

  <script
    type="application/json"
    id="datos-escanos"
    is:inline
    set:html={JSON.stringify(circunscripciones)}
  ></script>

  <script
    type="application/json"
    id="datos-2023"
    is:inline
    set:html={JSON.stringify(datos2023)}
  ></script>

  <script>
    import { repartir } from '../lib/dhondt.js';
    import { decimas, maximoCampo, recortar } from '../lib/porcentajes.js';

    const nf1 = new Intl.NumberFormat('es-ES', {
      minimumFractionDigits: 1,
      maximumFractionDigits: 1,
    });
    const nf0 = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 0 });
    const nf2 = new Intl.NumberFormat('es-ES', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

    /** Colores estables por partido: el PP siempre es azul, el PSOE siempre rojo. */
    const COLORES = [
      { clave: 'PP', color: '#1B4D8F' },
      { clave: 'POPULAR', color: '#1B4D8F' },
      { clave: 'PSOE', color: '#E30613' },
      { clave: 'PSE', color: '#E30613' },
      { clave: 'PSC', color: '#E30613' },
      { clave: 'SOCIALISTA', color: '#E30613' },
      { clave: 'VOX', color: '#63BE21' },
      { clave: 'SUMAR', color: '#E51C55' },
      { clave: 'PODEMOS', color: '#7A2F8F' },
      { clave: 'IU', color: '#C62828' },
      { clave: 'ERC', color: '#F2A20C' },
      { clave: 'ESQUERRA', color: '#F2A20C' },
      { clave: 'JUNTS', color: '#00A3A3' },
      { clave: 'JXCAT', color: '#00A3A3' },
      { clave: 'BILDU', color: '#7AC143' },
      { clave: 'PNV', color: '#00843D' },
      { clave: 'EAJ', color: '#00843D' },
      { clave: 'BNG', color: '#2E86C1' },
      { clave: 'CC', color: '#F5C400' },
      { clave: 'CANARIA', color: '#F5C400' },
      { clave: 'CANARIAS', color: '#FFB300' },
      { clave: 'NC', color: '#FFB300' },
      { clave: 'PACMA', color: '#6A994E' },
      { clave: 'CIUDADANOS', color: '#EB6109' },
      { clave: 'CS', color: '#EB6109' },
      { clave: 'UPN', color: '#1B4D8F' },
      { clave: 'PRC', color: '#00843D' },
      { clave: 'FORO', color: '#1B4D8F' },
      { clave: 'CUP', color: '#F2A20C' },
      { clave: 'MES', color: '#2A9D8F' },
      { clave: 'COMPROMIS', color: '#2A9D8F' },
      { clave: 'TERUEL', color: '#C2185B' },
      { clave: 'GEROA', color: '#00843D' },
      { clave: 'ASG', color: '#F5C400' },
    ];
    const COLORES_FRASE = [{ texto: 'EL PI', color: '#2A9D8F' }];
    const PALETA_RESERVA = ['#5C6BC0', '#8D6E63', '#00897B', '#6A1B9A', '#EF6C00', '#546E7A'];

    function colorPartido(nombre) {
      const normalizado = nombre
        .normalize('NFKD')
        .replace(/\p{M}/gu, '')
        .toUpperCase()
        .trim();
      for (const { texto, color } of COLORES_FRASE) {
        if (normalizado.includes(texto)) return color;
      }
      const palabras = new Set(normalizado.split(/[^A-Z0-9]+/).filter(Boolean));
      for (const { clave, color } of COLORES) {
        if (palabras.has(clave)) return color;
      }
      let hash = 0;
      for (const caracter of normalizado) hash = (hash * 31 + caracter.charCodeAt(0)) >>> 0;
      return PALETA_RESERVA[hash % PALETA_RESERVA.length];
    }

    const $ = (id) => document.getElementById(id);

    const circunscripciones = JSON.parse($('datos-escanos').textContent);
    const datos2023 = JSON.parse($('datos-2023').textContent);

    const contenedor = $('partidos');
    const selectProvincia = $('provincia');
    const resumen = $('resumen');
    const resultado = $('resultado');
    const cocientesDiv = $('cocientes');
    const escanosProv = $('escanos-prov');
    const badge = $('modo-badge');
    const botonModo = $('reproducir');
    const disponible = $('disponible');
    const umbralTexto = $('umbral');
    const anuncio = $('anuncio');
    const controles = new Map();

    function partidosIniciales() {
      return ['A', 'B', 'C', 'D', 'E', 'F'].map((letra, i) => {
        const nombre = `Partido ${letra}`;
        return { id: `p${i + 1}`, nombre, valor: 0, color: colorPartido(nombre) };
      });
    }

    let partidos = partidosIniciales();
    let blanco = 0;
    let modo2023 = false;
    let exacto = null;
    let temporizadorAnuncio;

    const nombreDe = (p, i) => p.nombre.trim() || `Partido ${i + 1}`;

    function nodo(tag, clase, texto) {
      const el = document.createElement(tag);
      if (clase) el.className = clase;
      if (texto !== undefined) el.textContent = texto;
      return el;
    }

    function anunciar(texto) {
      clearTimeout(temporizadorAnuncio);
      temporizadorAnuncio = setTimeout(() => {
        anuncio.textContent = texto;
      }, 400);
    }

    const valoresDecimas = () => [...partidos.map((p) => decimas(p.valor)), decimas(blanco)];

    function maximoPartido(id) {
      const indice = partidos.findIndex((p) => p.id === id);
      return indice < 0 ? 0 : maximoCampo(valoresDecimas(), indice);
    }

    const maximoBlanco = () => maximoCampo(valoresDecimas(), partidos.length);

    function actualizarModo() {
      badge.hidden = !modo2023;
      botonModo.textContent = modo2023 ? 'Salir del modo 2023' : 'Reproducir 2023';
      botonModo.setAttribute('aria-pressed', modo2023 ? 'true' : 'false');
    }

    function actualizarLimites() {
      for (const p of partidos) {
        const control = controles.get(p.id);
        if (!control) continue;
        const maximo = maximoPartido(p.id);
        const bloqueado = maximo === 0 && decimas(p.valor) === 0;
        control.rango.max = String(maximo / 10);
        control.numero.max = String(maximo / 10);
        control.rango.disabled = bloqueado;
        control.numero.disabled = bloqueado;
      }

      const maximoB = maximoBlanco();
      const bloqueadoB = maximoB === 0 && decimas(blanco) === 0;
      $('blanco-rango').max = String(maximoB / 10);
      $('blanco-numero').max = String(maximoB / 10);
      $('blanco-rango').disabled = bloqueadoB;
      $('blanco-numero').disabled = bloqueadoB;

      // No se pueden añadir filas si ya está todo asignado.
      const ocupado = partidos.reduce((suma, p) => suma + decimas(p.valor), 0) + decimas(blanco);
      $('anadir').disabled = ocupado >= 1000 || partidos.length >= 12;
    }

    function salirModo2023() {
      if (!modo2023) return;
      modo2023 = false;
      exacto = null;
      actualizarModo();
      actualizarLimites();
      calcular();
    }

    function crearFila(p, indice) {
      p.color = colorPartido(p.nombre);

      const fila = nodo('div', 'calc-fila');

      const punto = nodo('span', 'calc-punto');
      punto.style.background = p.color;
      punto.setAttribute('aria-hidden', 'true');

      const nombre = document.createElement('input');
      nombre.type = 'text';
      nombre.className = 'calc-nombre';
      nombre.value = p.nombre;
      nombre.setAttribute('aria-label', `Nombre del partido ${indice + 1}`);

      const rango = document.createElement('input');
      rango.type = 'range';
      rango.className = 'calc-rango';
      rango.min = '0';
      rango.max = '100';
      rango.step = '0.1';
      rango.value = String(p.valor);
      rango.setAttribute('aria-label', `Porcentaje de ${nombreDe(p, indice)}`);

      const numero = document.createElement('input');
      numero.type = 'number';
      numero.className = 'calc-numero';
      numero.min = '0';
      numero.max = '100';
      numero.step = '0.1';
      numero.inputMode = 'decimal';
      numero.value = String(p.valor);
      numero.setAttribute('aria-label', `Porcentaje de ${nombreDe(p, indice)}`);

      nombre.addEventListener('input', () => {
        p.nombre = nombre.value;
        p.color = colorPartido(p.nombre);
        punto.style.background = p.color;
        const etiqueta = `Porcentaje de ${nombreDe(p, indice)}`;
        rango.setAttribute('aria-label', etiqueta);
        numero.setAttribute('aria-label', etiqueta);
        calcular();
      });

      const aplicar = (valor, origen) => {
        if (modo2023) {
          modo2023 = false;
          exacto = null;
          actualizarModo();
        }
        const maximo = maximoPartido(p.id);
        const vDecimas = recortar(valor, maximo);
        const v = vDecimas / 10;
        p.valor = v;
        if (origen !== rango) rango.value = String(v);
        if (origen !== numero) numero.value = String(v);
        if (origen && decimas(valor) !== vDecimas) origen.value = String(v);
        actualizarLimites();
        calcular();
      };
      rango.addEventListener('input', () => aplicar(rango.value, rango));
      numero.addEventListener('input', () => aplicar(numero.value, numero));

      controles.set(p.id, { rango, numero });

      const pct = nodo('span', 'calc-pct', '%');
      pct.setAttribute('aria-hidden', 'true');

      fila.append(punto, nombre, rango, numero, pct);
      return fila;
    }

    function pintarPartidos() {
      controles.clear();
      contenedor.textContent = '';
      partidos.forEach((p, i) => contenedor.append(crearFila(p, i)));
    }

    function sincronizarBlanco() {
      const rango = $('blanco-rango');
      const numero = $('blanco-numero');
      const aplicar = (valor, origen) => {
        if (modo2023) {
          modo2023 = false;
          exacto = null;
          actualizarModo();
        }
        const vDecimas = recortar(valor, maximoBlanco());
        const v = vDecimas / 10;
        blanco = v;
        if (origen !== rango) rango.value = String(v);
        if (origen !== numero) numero.value = String(v);
        if (origen && decimas(valor) !== vDecimas) origen.value = String(v);
        actualizarLimites();
        calcular();
      };
      rango.addEventListener('input', () => aplicar(rango.value, rango));
      numero.addEventListener('input', () => aplicar(numero.value, numero));
    }

    function cargar2023() {
      const provincia = datos2023.provincias.find(
        (p) => p.codigo === selectProvincia.value,
      );
      if (!provincia) return;

      const orden = [...provincia.partidos].sort((a, b) => b.votos - a.votos);
      const visibles = orden.slice(0, 10);
      const resto = orden.slice(10);
      const validos =
        orden.reduce((suma, p) => suma + p.votos, 0) + provincia.blanco;

      partidos = visibles.map((p, i) => ({
        id: `p${i + 1}`,
        nombre: p.siglas,
        valor: Number(((p.votos / validos) * 100).toFixed(1)),
        color: colorPartido(p.siglas),
      }));
      blanco = Number(((provincia.blanco / validos) * 100).toFixed(1));

      exacto = {
        escanos: provincia.escanos,
        votos: Object.fromEntries(visibles.map((p, i) => [`p${i + 1}`, p.votos])),
        blanco: provincia.blanco,
        otros: resto.reduce((suma, p) => suma + p.votos, 0),
        validos,
      };
      modo2023 = true;

      pintarPartidos();
      $('blanco-rango').value = String(blanco);
      $('blanco-numero').value = String(blanco);
      actualizarModo();
      actualizarLimites();
      calcular();
    }

    function calcular() {
      const provincia = circunscripciones.find((c) => c.codigo === selectProvincia.value);
      const escanos = modo2023 ? exacto.escanos : provincia.diputados;
      escanosProv.textContent =
        `${escanos} diputado${escanos === 1 ? '' : 's'}` +
        (escanos === 1 ? ' · circunscripción uninominal' : '') +
        (modo2023 ? ' · 2023' : '');

      const votos = {};
      const meta = {};

      if (modo2023) {
        for (const [i, p] of partidos.entries()) {
          const votosPartido = exacto.votos[p.id];
          if (votosPartido) {
            votos[p.id] = votosPartido;
            meta[p.id] = { nombre: nombreDe(p, i), color: p.color };
          }
        }
      } else {
        for (const [i, p] of partidos.entries()) {
          const peso = Math.round(p.valor * 1000);
          if (peso > 0) {
            votos[p.id] = peso;
            meta[p.id] = { nombre: nombreDe(p, i), color: p.color };
          }
        }
      }

      // Sin partidos ni blanco no hay nada que repartir.
      if (Object.keys(votos).length === 0 && decimas(blanco) === 0) {
        resumen.textContent = 'Introduce porcentajes para ver el reparto.';
        disponible.textContent = 'Otros partidos (sin asignar): 100,0%';
        umbralTexto.textContent = 'Umbral del 3% de los votos válidos';
        resultado.textContent = '';
        resultado.append(
          nodo(
            'p',
            'calc-vacio',
            'Aún no hay votos que repartir. Mueve los porcentajes de la izquierda.',
          ),
        );
        cocientesDiv.textContent = '';
        anunciar('Sin votos que repartir.');
        return;
      }

      const blancoPeso = modo2023 ? exacto.blanco : Math.round(blanco * 1000);
      const otros = modo2023
        ? exacto.otros
        : Math.max(0, 100000 - Object.values(votos).reduce((a, b) => a + b, 0) - blancoPeso);

      const r = repartir({ votos, escanos, blanco: blancoPeso, otros });

      const pct = (n) => (r.validos > 0 ? (n / r.validos) * 100 : 0);
      const totalPartidos = Object.values(votos).reduce((a, b) => a + b, 0);

      if (modo2023) {
        const partes = [`Datos oficiales del 23J · partidos ${nf1.format(pct(totalPartidos))}%`];
        if (blancoPeso > 0) partes.push(`blanco ${nf1.format(pct(blancoPeso))}%`);
        if (otros > 0) partes.push(`otros ${nf1.format(pct(otros))}%`);
        resumen.textContent = partes.join(' · ');
        disponible.textContent = 'Datos oficiales de 2023 cargados';
        umbralTexto.textContent = `Umbral del 3%: ${nf0.format(r.umbral)} votos`;
      } else {
        const partes = [`Partidos: ${nf1.format(totalPartidos / 1000)}%`];
        if (blancoPeso > 0) partes.push(`blanco: ${nf1.format(blancoPeso / 1000)}%`);
        if (otros > 0) partes.push(`otros: ${nf1.format(otros / 1000)}%`);
        resumen.textContent = partes.join(' · ');
        disponible.textContent =
          otros > 0
            ? `Otros partidos (sin asignar): ${nf1.format(otros / 1000)}%`
            : '100% asignado';
        umbralTexto.textContent = 'Umbral del 3% de los votos válidos';
      }

      pintarResultado(r, votos, meta, escanos);
      pintarCocientes(r, meta);
    }

    function pintarResultado(r, votos, meta, escanos) {
      resultado.textContent = '';

      if (r.aptos.length === 0) {
        resultado.append(
          nodo(
            'p',
            'calc-vacio',
            'Ninguna candidatura alcanza el 3% de los votos válidos: no se asigna ningún escaño.',
          ),
        );
        anunciar('Ninguna candidatura alcanza el 3%. No se asigna ningún escaño.');
        return;
      }

      const pctVotos = (id) => (votos[id] / r.validos) * 100;
      const conEscano = Object.keys(votos)
        .map((id) => ({ id, escanos: r.asignados[id] ?? 0, pct: pctVotos(id) }))
        .filter((x) => x.escanos > 0)
        .sort((a, b) => b.escanos - a.escanos || b.pct - a.pct);

      const totalEscanos = conEscano.reduce((a, b) => a + b.escanos, 0);
      const cifra = nodo('p', 'calc-total');
      cifra.append(nodo('b', null, String(totalEscanos)));
      cifra.append(document.createTextNode(` de ${escanos} escaños asignados`));
      resultado.append(cifra);

      const barras = nodo('div', 'calc-barras');
      for (const x of conEscano) {
        const cuota = (x.escanos / escanos) * 100;
        const fila = nodo('div', 'calc-barra');
        const cabecera = nodo('div', 'calc-barra-cabecera');
        cabecera.append(nodo('span', 'calc-barra-nombre', meta[x.id].nombre));
        cabecera.append(
          nodo(
            'span',
            'calc-barra-datos',
            `${x.escanos} escaño${x.escanos === 1 ? '' : 's'} · ${nf1.format(cuota)}% de escaños · ${nf1.format(x.pct)}% de votos`,
          ),
        );
        const pista = nodo('div', 'calc-barra-pista');
        const relleno = nodo('div', 'calc-barra-relleno');
        relleno.style.width = `${cuota}%`;
        relleno.style.background = meta[x.id].color;
        pista.append(relleno);
        fila.append(cabecera, pista);
        barras.append(fila);
      }
      resultado.append(barras);

      const sinEscano = Object.keys(votos)
        .map((id) => ({ id, pct: pctVotos(id) }))
        .filter((x) => (r.asignados[x.id] ?? 0) === 0 && x.pct >= 3)
        .sort((a, b) => b.pct - a.pct);

      if (sinEscano.length) {
        resultado.append(
          nodo(
            'p',
            'calc-nota',
            `Superan el 3% pero no obtienen escaño: ${sinEscano
              .map((x) => `${meta[x.id].nombre} (${nf1.format(x.pct)}%)`)
              .join(', ')}.`,
          ),
        );
      }

      const excluidos = Object.keys(votos)
        .map((id) => ({ id, pct: pctVotos(id) }))
        .filter((x) => x.pct < 3)
        .sort((a, b) => b.pct - a.pct);

      if (excluidos.length) {
        resultado.append(
          nodo(
            'p',
            'calc-nota',
            `Fuera por el umbral del 3%: ${excluidos
              .map((x) => `${meta[x.id].nombre} (${nf1.format(x.pct)}%)`)
              .join(', ')}.`,
          ),
        );
      }

      const anuncioEscanos = conEscano
        .map((x) => `${meta[x.id].nombre} ${x.escanos}`)
        .join(', ');
      anunciar(`${totalEscanos} de ${escanos} escaños. ${anuncioEscanos}.`);
    }

    function pintarCocientes(r, meta) {
      cocientesDiv.textContent = '';
      if (!r.ganadores.length) return;

      const tabla = nodo('table', 'calc-tabla');
      const thead = document.createElement('thead');
      const filaCabecera = document.createElement('tr');
      for (const titulo of ['#', 'Partido', 'División', 'Cociente']) {
        filaCabecera.append(nodo('th', null, titulo));
      }
      thead.append(filaCabecera);
      tabla.append(thead);

      const tbody = document.createElement('tbody');
      r.ganadores.forEach((g, i) => {
        const fila = document.createElement('tr');
        fila.append(nodo('td', 'num', String(i + 1)));
        fila.append(nodo('td', null, meta[g.partido].nombre));
        fila.append(nodo('td', 'num', `÷ ${g.divisor}`));
        fila.append(nodo('td', 'num', `${nf2.format(g.cociente / (r.validos / 100))}%`));
        tbody.append(fila);
      });
      tabla.append(tbody);
      cocientesDiv.append(tabla);

      if (r.siguiente) {
        cocientesDiv.append(
          nodo(
            'p',
            'calc-nota',
            `Primer cociente sin escaño: ${meta[r.siguiente.partido].nombre} ÷ ${r.siguiente.divisor} = ${nf2.format(r.siguiente.cociente / (r.validos / 100))}%.`,
          ),
        );
      }
    }

    $('anadir').addEventListener('click', () => {
      if (partidos.length >= 12) return;
      if (modo2023) {
        modo2023 = false;
        exacto = null;
        actualizarModo();
      }
      const i = partidos.length;
      const letra = String.fromCharCode(65 + (i % 26));
      const nombre = `Partido ${letra}`;
      const p = {
        id: `p${i + 1}`,
        nombre,
        valor: 0,
        color: colorPartido(nombre),
      };
      partidos.push(p);
      contenedor.append(crearFila(p, i));
      actualizarLimites();
      calcular();
    });

    $('reiniciar').addEventListener('click', () => {
      modo2023 = false;
      exacto = null;
      partidos = partidosIniciales();
      blanco = 0;
      $('blanco-rango').value = '0';
      $('blanco-numero').value = '0';
      pintarPartidos();
      actualizarModo();
      actualizarLimites();
      calcular();
    });

    botonModo.addEventListener('click', () => {
      if (modo2023) salirModo2023();
      else cargar2023();
    });

    selectProvincia.addEventListener('change', () => {
      if (modo2023) cargar2023();
      else calcular();
    });

    pintarPartidos();
    sincronizarBlanco();
    actualizarModo();
    actualizarLimites();
    calcular();
  </script>

