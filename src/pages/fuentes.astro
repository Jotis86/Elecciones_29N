---
import Base from '../layouts/Base.astro';
import Compartir from '../components/Compartir.astro';
import {
  partidos,
  temas,
  fichaDe,
  documentoDe,
  enlacePdf,
  etiquetaPdf,
} from '../lib/datos';

const filas = partidos.map((partido) => ({
  partido,
  documento: documentoDe(partido.slug),
  ficha: fichaDe(partido.slug),
}));

const disponibles = partidos.filter((p) => p.estado === 'disponible');
const pendientes = partidos.filter((p) => p.estado === 'pendiente');
const conArchivo = partidos.filter((p) => p.pdf_archivado).length;
const fechaCorta = (iso: string | null) =>
  iso
    ? new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }).format(
        new Date(`${iso}T00:00:00`),
      )
    : '—';

const cortos: Record<string, string> = {
  vivienda: 'Viv.',
  'economia-fiscalidad': 'Econ.',
  empleo: 'Empl.',
  inmigracion: 'Inmig.',
  sanidad: 'San.',
  educacion: 'Educ.',
  pensiones: 'Pens.',
  'energia-medioambiente': 'Energ.',
  'seguridad-defensa': 'Seg.',
  'estado-instituciones': 'Estado',
  territorio: 'Territ.',
  'europa-exterior': 'Europa',
  'derechos-sociales': 'Derech.',
  'campo-pesca': 'Campo',
  infraestructuras: 'Infra.',
  'cultura-deporte': 'Cult.',
};

const cobertura = disponibles.map((partido) => {
  const ficha = fichaDe(partido.slug);
  const valores = temas.map((tema) => ({
    tema,
    n: ficha?.temas[tema.slug]?.propuestas.length ?? 0,
  }));
  return {
    partido,
    ficha,
    valores,
    total: valores.reduce((n, v) => n + v.n, 0),
  };
});

const totalPorTema = temas.map((tema, i) =>
  cobertura.reduce((n, fila) => n + fila.valores[i].n, 0),
);
const total = cobertura.reduce((n, fila) => n + fila.total, 0);
---

<Base
  titulo="Fuentes y cobertura"
  descripcion="Registro público de fuentes de los programas del 29N: PDF oficial, copia archivada, fechas, páginas y cobertura por partido y tema."
>
  <header class="pagina-cabecera">
    <div class="wrap">
      <p class="migas"><a href="/">Inicio</a> / Fuentes y cobertura</p>
      <h1>Fuentes y cobertura</h1>
      <p class="entradilla">
        De dónde sale cada programa, qué documento se usó y qué temas están
        cubiertos. Los PDFs no se alojan en esta web: se enlazan a la fuente
        oficial y, cuando existe, a una copia archivada.
      </p>
      <div class="datos-partido">
        <span><b>{disponibles.length}</b> programas publicados</span>
        <span><b>{temas.length}</b> temas</span>
        <span><b>{total}</b> propuestas citadas</span>
        <span><b>{conArchivo}</b> copias archivadas</span>
      </div>
    </div>
  </header>

  <section class="seccion">
    <div class="wrap">
      <h2>Fuentes documentales</h2>
      <p class="prosa">
        Fecha de publicación, fecha de descarga, número de páginas y huella del
        PDF usado para extraer el texto. La huella permite detectar si el
        documento cambia.
      </p>

      <div class="grid-fuentes">
        {filas.map(({ partido, documento, ficha }) => {
          const descarga = enlacePdf(partido);
          const publicado = fechaCorta(partido.publicado);
          const descargado = fechaCorta(partido.descargado);
          return (
            <article class="fuente" style={`--acento:${partido.color}`}>
              <div class="fuente-cabecera">
                <div>
                  <h3>
                    <a href={`/partido/${partido.slug}/`}>{partido.siglas}</a>
                  </h3>
                  <p class="fuente-ambito">{partido.ambito}</p>
                </div>
                <span class={partido.estado === 'disponible' ? 'estado ok' : 'estado pendiente'}>
                  {partido.estado === 'disponible' ? 'Publicado' : 'Pendiente'}
                </span>
              </div>

              <p class="fuente-programa">{partido.programa ?? '—'}</p>

              <dl class="fuente-datos">
                <div>
                  <dt>Publicado</dt>
                  <dd>{publicado}</dd>
                </div>
                <div>
                  <dt>Descargado</dt>
                  <dd>{descargado}</dd>
                </div>
                <div>
                  <dt>Páginas</dt>
                  <dd>{documento?.paginas ?? '—'}</dd>
                </div>
                <div>
                  <dt>Temas</dt>
                  <dd>{ficha ? `${Object.keys(ficha.temas).length}/16` : '—'}</dd>
                </div>
              </dl>

              {partido.notas && <p class="fuente-nota">{partido.notas}</p>}

              <div class="fuente-pie">
                {descarga ? (
                  <a
                    class="boton"
                    href={descarga}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Abrir el PDF oficial del programa"
                  >
                    Abrir PDF oficial ↗
                  </a>
                ) : (
                  <span class="fuente-sin">Sin PDF</span>
                )}
                {partido.pdf_archivado && (
                  <a
                    class="boton secundario"
                    href={partido.pdf_archivado}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Copia archivada en Wayback Machine; es la usada para verificar las citas"
                  >
                    Copia archivada ↗
                  </a>
                )}
              </div>

              {documento && (
                <p class="fuente-sha">
                  <span>SHA-256</span>
                  <code title={documento.sha256}>{documento.sha256.slice(0, 10)}…</code>
                </p>
              )}
            </article>
          );
        })}
      </div>

      <p class="aviso-legal">
        {conArchivo} de {disponibles.length} programas tienen copia archivada.
        {pendientes.length > 0 && <> Pendientes: {pendientes.map((p) => p.siglas).join(', ')}.</>}
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="wrap">
      <h2>Cobertura por partido y tema</h2>
      <p class="prosa">
        Cada celda indica cuántas propuestas citadas hay en ese tema. Un guion
        significa que el partido tiene programa, pero todavía no hay ficha en ese
        tema. Los partidos pendientes no aparecen en la matriz.
      </p>

      <div class="tabla-scroll tabla-cobertura-wrap">
        <table class="tabla-cobertura">
          <caption class="visualmente-oculto">
            Número de propuestas citadas por partido y tema
          </caption>
          <thead>
            <tr>
              <th scope="col">Partido</th>
              {temas.map((tema) => (
                <th scope="col">
                  <abbr title={tema.nombre}>{cortos[tema.slug] ?? tema.nombre}</abbr>
                </th>
              ))}
              <th scope="col">Total</th>
            </tr>
          </thead>
          <tbody>
            {cobertura.map(({ partido, valores, total: totalPartido }) => (
              <tr>
                <th scope="row">
                  <a href={`/partido/${partido.slug}/`}>{partido.siglas}</a>
                </th>
                {valores.map(({ tema, n }) => (
                  <td>
                    {n > 0 ? (
                      <a
                        href={`/partido/${partido.slug}/#tema-${tema.slug}`}
                        title={`${partido.siglas} · ${tema.nombre}: ${n} propuestas`}
                      >
                        {n}
                      </a>
                    ) : (
                      <span class="sin">—</span>
                    )}
                  </td>
                ))}
                <td class="num"><strong>{totalPartido}</strong></td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Total</th>
              {totalPorTema.map((n) => <td class="num">{n}</td>)}
              <td class="num"><strong>{total}</strong></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <div class="cobertura-movil">
        {cobertura.map(({ partido, valores, total: totalPartido }) => {
          const conDatos = valores.filter((v) => v.n > 0);
          return (
            <article class="cobertura-ficha">
              <div class="cobertura-ficha-cabecera">
                <h3><a href={`/partido/${partido.slug}/`}>{partido.siglas}</a></h3>
                <span>{totalPartido} propuestas</span>
              </div>
              <div class="cobertura-chips">
                {conDatos.map(({ tema, n }) => (
                  <span><b>{tema.nombre}</b> {n}</span>
                ))}
              </div>
            </article>
          );
        })}
      </div>

      <p class="aviso-legal">
        La matriz se genera a partir de las fichas de <code>data/propuestas</code>.
        Si un tema no aparece, no hay propuestas citadas; no significa que el
        programa no lo mencione.
      </p>
    </div>
  </section>

  <Compartir texto="Fuentes y cobertura de los programas del 29N" />
</Base>
