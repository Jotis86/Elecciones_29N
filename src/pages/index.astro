---
import Base from '../layouts/Base.astro';
import Compartir from '../components/Compartir.astro';
import TarjetaPartido from '../components/TarjetaPartido.astro';import {
  partidos,
  temas,
  fichas,
  partidosDisponibles,
  partidosPendientes,
  totalPropuestas,
  fichasPorTema,
} from '../lib/datos';
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">Elecciones generales · 29 de noviembre de 2026</p>
      <h1>Qué propone cada partido, tema por tema.</h1>
      <p class="entradilla">
        Los programas electorales, resumidos en lenguaje claro y con cada
        propuesta enlazada a la página exacta del documento oficial. Sin
        interpretaciones sin respaldo: si una cita está aquí, está en el PDF.
      </p>

      <div class="cifras">
        <div class="cifra">
          <b>{partidosDisponibles.length}</b>
          <span>programas publicados</span>
        </div>
        <div class="cifra">
          <b>{fichas.length}</b>
          <span>ya analizados</span>
        </div>
        <div class="cifra">
          <b>{temas.length}</b>
          <span>temas electorales</span>
        </div>
        <div class="cifra">
          <b>{totalPropuestas}</b>
          <span>propuestas citadas</span>
        </div>
      </div>

      <p style="margin-top:1.6rem; display:flex; flex-wrap:wrap; gap:0.8rem 1.8rem">
        <a class="enlace-flecha" href="/buscar">Buscar una palabra en todos los programas →</a>
        <a class="enlace-flecha" href="/calculadora">Calcular escaños con D’Hondt →</a>
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="wrap">
      <div class="seccion-cabecera">
        <h2>Los partidos</h2>
        <p>
          {partidosDisponibles.length} con programa publicado y{' '}
          {partidosPendientes.length} pendientes de que lo presenten.
        </p>
      </div>

      <div class="grid grid-partidos">
        {partidos.map((partido) => <TarjetaPartido partido={partido} />)}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="wrap">
      <div class="seccion-cabecera">
        <h2>Explorar por tema</h2>
        <p>Compara lo que proponen todos los partidos sobre lo que te importa.</p>
      </div>

      <div class="grid grid-temas">
        {
          temas.map((tema) => {
            const n = fichasPorTema(tema.slug).length;
            return (
              <a class="tarjeta" href={`/tema/${tema.slug}`}>
                <h3>{tema.nombre}</h3>
                <p>{tema.descripcion}</p>
                <span class="cuenta">
                  {n > 0 ? `${n} partido${n === 1 ? '' : 's'} analizado${n === 1 ? '' : 's'}` : 'En preparación'}
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="wrap">
      <h2>Cómo leer una ficha</h2>
      <p class="prosa">
        Cada partido tiene una ficha por tema. Arriba, un resumen en lenguaje llano
        de lo que propone. Debajo, las frases exactas de su programa en las que se
        basa ese resumen, con la página y un enlace para abrirla en el PDF.
      </p>
      <p class="prosa">
        Antes de publicar, un programa revisa cada frase: si una no aparece tal cual
        en la página indicada, la web no se publica. Así puedes comprobar cualquier
        afirmación en dos clics.
      </p>
      <p class="prosa">
        La cobertura está en curso: faltan partidos y algunos temas, y los añadimos
        por tandas. <a href="/sobre">Aquí explicamos</a>{' '}el método y los criterios.
      </p>
      <Compartir texto="Los programas del 29N, resumidos y verificables" />
    </div>
  </section>
</Base>
